<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="author" content="{{ site.author }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
{% if layout == 'post.njk' %}{% set ogImage = "/og/" + page.fileSlug + ".png" %}{% else %}{% set ogImage = "/og/default.png" %}{% endif %}
<meta property="og:image" content="{{ site.url }}{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title or site.title }} — {{ site.author }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Sora:wght@400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a class="brand" href="/"><img class="logo" src="/img/logo-tile.svg" alt="" width="44" height="44"><span class="brand-name">{{ site.title }}</span><span class="brand-tag">Blog</span></a>
    <div class="nav-links">
      <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a>
      <a href="/essays/" {% if page.url and page.url.startsWith("/essays/") %}aria-current="page"{% endif %}>Essays</a>
      <a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a>
      <a class="pill" href="/#subscribe">Subscribe</a>
    </div>
  </nav>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="container">
    <span>© {{ year }} {{ site.title }}</span>
    <span>{{ site.tagline }} · <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></span>
  </div>
</footer>
<script>
(function () {
  var header = document.querySelector(".site-header");
  if (!header) return;
  var lastY = window.scrollY, ticking = false, showTimer = null;
  var THRESHOLD = 8;       // ignore tiny scroll jitters (px)
  var SHOW_DELAY = 400;    // wait this long (ms) after scrolling up before the header returns
  function hide() { clearTimeout(showTimer); showTimer = null; header.classList.add("is-hidden"); }
  function show(now) {
    if (now) { clearTimeout(showTimer); showTimer = null; header.classList.remove("is-hidden"); return; }
    if (showTimer || !header.classList.contains("is-hidden")) return;
    showTimer = setTimeout(function () { showTimer = null; header.classList.remove("is-hidden"); }, SHOW_DELAY);
  }
  function update() {
    var y = window.scrollY;
    var past = y > header.offsetHeight + 40;
    if (!past) show(true);                       // near the top: always visible
    else if (y - lastY > THRESHOLD) hide();      // scrolling down
    else if (lastY - y > THRESHOLD) show(false); // scrolling up: return after a short pause
    if (Math.abs(y - lastY) > THRESHOLD) lastY = y;
    ticking = false;
  }
  window.addEventListener("scroll", function () {
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  header.addEventListener("focusin", function () { show(true); });
})();
</script>
</body>
</html>
